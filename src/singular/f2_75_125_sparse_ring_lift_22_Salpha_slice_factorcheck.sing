print("GENERATORS");
print(size(I));
print("ACTIVE_VARIABLES");
print("16");
print("COMPUTING_STANDARD_BASIS");
ideal G=slimgb(I);
print("BASIS_SIZE");
print(size(G));
if (size(G)==1 && G[1]==1) {
  print("UNIT_IDEAL");
  matrix L=lift(I,1);
  print("LIFT_CERTIFICATE");
  print(L);
  poly C=0;
  for (int j=1; j<=size(L); j++) { C=C+L[j,1]*I[j]; }
  print("LIFTED_COMBINATION_CHECK");
  print(C);
  if (C==1) { print("CERTIFICATE_VERIFIED"); }
  else { print("CERTIFICATE_CHECK_FAILED"); }
} else {
  print("NOT_UNIT_IDEAL");
}
list ff=factorize(G[1]);
ideal facideal=ff[1];
intvec facmult=ff[2];
poly facprod=1;
for (int fj=1; fj<=size(facideal); fj++) { facprod=facprod*facideal[fj]^facmult[fj]; }
print("FACTOR_DATA_BEGIN");
print(ff);
print("FACTOR_IDENTITY_REMAINDER");
print(facprod-G[1]);
int reduction_failures=0;
for (int ri=1; ri<=size(I); ri++) { if (reduce(I[ri],G)!=0) { reduction_failures++; } }
print("INPUT_GENERATOR_REMAINDERS");
print(reduction_failures);
matrix liftG=lift(I,G[1]);
poly lift_combination=0;
for (int li=1; li<=size(I); li++) { lift_combination=lift_combination+liftG[li,1]*I[li]; }
print("BASIS_LIFT_REMAINDER");
print(lift_combination-G[1]);
